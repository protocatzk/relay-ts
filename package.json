{
  "name": "restreamer-ts",
  "version": "0.9.2",
  "private": true,
  "description": "TikTok to YouTube restreaming service with delay buffer, watchdog and web dashboard",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run typecheck:web && npm run lint && npm run openapi:check && npm run test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.12",
    "@napi-rs/canvas": "^1.1.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "js-yaml": "^4.1.1",
    "mpegts.js": "^1.8.2",
    "pino": "^9.14.0",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "eslint": "^10.15.0",
    "prettier": "^3.7.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "glob": "^14.0.6"
  }
}
