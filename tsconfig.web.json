{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/web/*"]
    }
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.d.ts", "src/web/**/*.vue"],
  "exclude": ["node_modules", "dist", "web"]
}
