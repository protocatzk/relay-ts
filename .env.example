# ---------------------------------------------------------------------------
# Restreamer TS – Konfiguration
# Kopieren: cp .env.example .env
# ---------------------------------------------------------------------------

TZ=Europe/Berlin

# Dashboard-Zugang. Leer = kein Login (nur sinnvoll, wenn der Port nicht
# öffentlich erreichbar ist). Bei öffentlichem Zugriff unbedingt setzen.
DASHBOARD_PASSWORD=
# Alternativ/ergänzend ein API-Token für Skripte (Authorization: Bearer).
API_TOKEN=
# Zufälliger Schlüssel zum Signieren der Session-Cookies. Leer = wird aus
# dem Passwort abgeleitet. Bei Passwortwechsel werden Sessions ungültig.
SESSION_SECRET=
# Dashboard-Änderungen haben Vorrang vor .env. Auf true setzen, wenn .env
# die Werte aus config/settings.yml bei jedem Start überschreiben soll.
SETTINGS_ENV_OVERRIDES=false

# HTTP-Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
LOG_LEVEL=info
# Nur setzen, wenn ein Reverse-Proxy davor steht (CORS für getrennte UI).
# CORS_ORIGIN=https://relay.example.com
# Cookies nur über HTTPS senden (bei TLS-Reverse-Proxy aktivieren).
# SECURE_COOKIES=true
# Client-IP aus X-Forwarded-For übernehmen (nur hinter vertrauenswürdigem
# Reverse-Proxy aktivieren, z. B. nginx-proxy).
TRUST_PROXY=false

# Telegram-Bot: Web-Login per Freigabe im privaten Chat.
# Token von @BotFather, IDs per /id im Bot ermitteln (kommagetrennt).
# Ohne Token oder ohne IDs bleibt der Telegram-Login deaktiviert.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Optional: Zielchat für Stream-Benachrichtigungen (sonst erste erlaubte ID).
TELEGRAM_NOTIFY_CHAT_ID=
TELEGRAM_NOTIFICATIONS=true

# TikTok-Session (sessionid-Cookie). Ohne Cookie kann TikTok die Extraktion
# verweigern. Wird beim Start in data/cookies.txt umgewandelt.
TIKTOK_SESSION_ID=
TIKTOK_TARGET_IDC=

# Pfade (relativ zum Projektverzeichnis)
# CONFIG_DIR=config
# STREAMERS_FILE=config/streamers.yml
# SETTINGS_FILE=config/settings.yml
# LOGS_DIR=logs
# DATA_DIR=data
# COOKIES_FILE=data/cookies.txt
# WEB_DIR=web/dist
# LOG_FILE=restreamer.log
# Hinweis (nativer systemd-Betrieb): Bei getrenntem Daten-/Code-Layout
# (WorkingDirectory=/srv/relay/current) müssen CONFIG_DIR, DATA_DIR, LOGS_DIR,
# STREAMERS_FILE, SETTINGS_FILE und COOKIES_FILE absolut gesetzt werden,
# sonst sucht die App sie relativ zum Release-Verzeichnis.

# Binaries (im Docker-Image bereits enthalten)
FFMPEG_BIN=ffmpeg
YTDLP_BIN=yt-dlp
YTDLP_TIMEOUT=45

# YouTube-Ausgang
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_BACKUP=false
# Globaler Fallback-Key, wenn ein Streamer keinen eigenen Key hat.
YOUTUBE_STREAM_KEY=
# Beispiel für einen per Streamer referenzierten Key (youtube_key_env).
# YOUTUBE_STREAM_KEY_BEISPIEL=xxxx-xxxx-xxxx-xxxx-xxxx

# YouTube-Verwaltung über die YouTube Data API v3 (#18).
# Client-ID und Clientschlüssel stammen aus der Google Cloud Console:
# APIs & Services → Credentials → OAuth 2.0 Client IDs → Webanwendung.
# Die Redirect-URI muss dort exakt als "Authorized redirect URI" eingetragen
# sein. Leer lassen = YouTube-Verwaltung deaktiviert.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://relay.positronium.dev/api/youtube/oauth/callback
# Öffentliche Dashboard-URL für Telegram-Links (Vorschau, YouTube-Setup).
DASHBOARD_URL=https://relay.positronium.dev

# Broadcast-Automation (Defaults; settings.yml gewinnt, solange
# SETTINGS_ENV_OVERRIDES nicht true ist). Einzelne Broadcasts können beim
# Anlegen/Ändern über die API abweichende Werte erhalten.
YOUTUBE_AUTO_TRANSITION=true
# off | relay_only | all – nur RELAY-Broadcasts oder auch Studio/Quick Live
YOUTUBE_AUTO_MODE=relay_only
YOUTUBE_AUTO_START=true
YOUTUBE_AUTO_STOP=true
YOUTUBE_DEFAULT_PRIVACY=unlisted
YOUTUBE_DEFAULT_DVR=true

# Lokaler MPEG-TS-Relay. Ingest auf RELAY_PORT, Playback auf RELAY_PORT+1.
RELAY_HOST=127.0.0.1
RELAY_PORT=12345

# Delay-Puffer (Sekunden, 0 = kein Puffer)
RELAY_DELAY_SECONDS=30
# DELAY_SECONDS=30

# Ausgabeformat. Unterstützt 720x1280, 1280x720, 1080x1920, 1920x1080,
# 1600x900. Höhere Auflösungen brauchen mehr CPU.
OUTPUT_RESOLUTION=720x1280
OUTPUT_FPS=25
VIDEO_BITRATE=4000
AUDIO_BITRATE=128
X264_PRESET=veryfast

# Watchdog
STALL_TIMEOUT=30
MIN_BITRATE=500
# Mindestrate der Quelle in Prozent Echtzeit (0 = aus)
SOURCE_MIN_RATE_PERCENT=85
WATCHDOG_INTERVAL=5
AUTO_RECONNECT=true

# Auto-Refresh der TikTok-URL
AUTO_REFRESH=true
AUTO_REFRESH_MINUTES=20

# Nach einem Quellen-Ausfall Pausenscreen senden, statt YouTube zu trennen.
PAUSE_ON_OFFLINE=true
PAUSE_ENABLED=true
PAUSE_TEXT=Stream pausiert
PAUSE_SUBTEXT=Gleich geht es weiter
# Maximale Pausendauer in Minuten (0 = unbegrenzt)
PAUSE_MAX_MINUTES=15
# Kurze Aussetzer überbrücken, bevor der Pausenscreen übernimmt
PAUSE_GRACE_SECONDS=2
# Optionales Hintergrundbild/-video (PNG/JPG/WebP/GIF/MP4/WebM, statisches SVG)
PAUSE_BACKGROUND=
# Optionaler Font (TTF/OTF); leer = automatische Schrift
PAUSE_FONT=
# Textfarbe auf dem Pausenscreen
PAUSE_TEXT_COLOR=white
# cover = ausfüllen, contain = einpassen
PAUSE_FIT=cover

# Startbildschirm vor dem Live-Stream (optional)
STARTUP_ENABLED=false
STARTUP_DURATION_SECONDS=10
STARTUP_TEXT=Gleich geht’s los.
STARTUP_SUBTEXT=Der Stream startet in wenigen Minuten.
STARTUP_BACKGROUND=
STARTUP_FONT=
STARTUP_TEXT_COLOR=white
STARTUP_FIT=cover
STARTUP_COLOR=0x101820

# Beim Start automatisch den ersten Streamer mit auto_start=true starten.
AUTO_START=true

# Online-Status (optional). Unterstützt TokTracker-ähnliche JSON-Antworten.
ONLINE_CHECK_ENABLED=false
ONLINE_SOURCE_URL=https://positronium.dev/track/api/public/overview
ONLINE_SOURCE_API_KEY=
ONLINE_CHECK_INTERVAL_SECONDS=60
ONLINE_AUTO_SWITCH_PREFERRED=false

# YouTube-Titel-Template (nur lokale Vorschau)
YOUTUBE_TITLE_TEMPLATE={name} – LIVE

# Einnahmen (optional, TokTracker-kompatibel)
EARNINGS_ENABLED=false
EARNINGS_SOURCE_URL=
EARNINGS_SOURCE_API_KEY=
EARNINGS_REFRESH_SECONDS=300
EARNINGS_PERIOD=today
EARNINGS_VIEW=standard
EARNINGS_OVERLAY_ENABLED=false
EARNINGS_OVERLAY_TEMPLATE={net} € · {coins} Coins
EARNINGS_OVERLAY_FONT_SIZE=22

# Chat-Overlay (optional). {handle} wird durch den TikTok-Handle ersetzt.
CHAT_API_URL=
CHAT_API_KEY=

# Overlay-Schrift (leer = automatische Suche)
OVERLAY_FONT=
